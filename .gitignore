# Repo-wide safety net. Each package (Backend/, post-application/) also keeps
# its own .gitignore; this covers the e2e/ package, which has none, and guards
# the whole tree against committing dependencies, build output, or secrets.

# Dependencies
node_modules/
.pnp
.pnp.js

# Secrets and local env. Real .env files never belong in the repo — the
# *.example templates document the shape instead.
.env
.env.local
.env.development
.env.*.local

# Build output
dist/
dist-ssr/
build/

# Test and coverage artefacts
coverage/
test-results/
playwright-report/
playwright/.cache/

# Downloaded seed photos (Backend/src/scripts/fetchPhotos.ts)
seed-assets/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS and editor
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea
*.swp
