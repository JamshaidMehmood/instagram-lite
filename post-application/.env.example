# Copy to `.env.development` and fill in. Create React App only exposes
# variables prefixed with REACT_APP_ to the bundle.

# Points the SPA at the local API.
REACT_APP_API_URL=http://localhost:5000/api/v1

# Google Identity Services client ID. Public by design — it identifies the app
# to Google; the ID token it yields is what the API verifies. Create one at
# https://console.cloud.google.com/apis/credentials and authorise
# http://localhost:3000 as a JavaScript origin.
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
