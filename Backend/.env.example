# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `src/config/env.ts` validates this at boot and
# refuses to start on anything missing or malformed.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=instagram_lite

# Must be >= 32 chars. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string-32-chars

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# OAuth 2.0 "Web application" client ID from Google Cloud Console
# (APIs & Services -> Credentials). This value is public: it ships inside the
# SPA bundle and is echoed in every ID token, so it is not a secret.
# There is deliberately no client secret here — this flow only *verifies* an ID
# token minted for the browser and never exchanges an authorization code, so
# the server has nothing to authenticate itself with.
# http://localhost:3000 must be listed as an authorised JavaScript origin on
# the client, or Google refuses to issue a credential to the dev frontend.
# Omit the line entirely to run without Google sign-in — the API boots fine and
# only /auth/google is affected. A blank value is rejected at boot rather than
# read as "disabled", so a half-finished setup fails loudly instead of quietly.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Comma-separated allowlist. Requests from other origins are rejected.
CORS_ORIGINS=http://localhost:3000

# 8 MiB
MAX_UPLOAD_BYTES=8388608

LOG_LEVEL=debug
